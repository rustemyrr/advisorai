# Anthropic (demo widget)
ANTHROPIC_API_KEY=your_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxxxxxx
# Admin/service-role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# Paddle Billing — use NEXT_PUBLIC_* for checkout (required)
# One price ID per plan (Starter / Standard / Professional) — must match the
# price IDs used in lib/paddle-plans.ts so the webhook can map purchases back to a plan.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER=pri_xxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_xxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ID_PROFESSIONAL=pri_xxxxxxxx
NEXT_PUBLIC_PADDLE_SANDBOX=true

# Optional server-only aliases (read by /api/paddle/config if NEXT_PUBLIC_* unset)
# PADDLE_CLIENT_TOKEN=test_xxxxxxxx
# PADDLE_PRICE_ID=pri_xxxxxxxx

# Server-side Paddle
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxx
# Webhook signing secret from Paddle > Developer tools > Notifications > your destination
PADDLE_WEBHOOK_SECRET=ntfset_xxxxxxxx
