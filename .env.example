# Anthropic (demo widget)
ANTHROPIC_API_KEY=your_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxxxxxx
# Admin/service-role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# Paddle Billing — use NEXT_PUBLIC_* for checkout (required)
# One price ID per plan (Starter / Standard / Professional) — must match the
# price IDs used in lib/paddle-plans.ts so the webhook can map purchases back to a plan.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER=pri_xxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_xxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ID_PROFESSIONAL=pri_xxxxxxxx
NEXT_PUBLIC_PADDLE_SANDBOX=true

# Optional server-only aliases (read by /api/paddle/config if NEXT_PUBLIC_* unset)
# PADDLE_CLIENT_TOKEN=test_xxxxxxxx
# PADDLE_PRICE_ID=pri_xxxxxxxx

# Server-side Paddle
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxx
# Webhook signing secret from Paddle > Developer tools > Notifications > your destination
PADDLE_WEBHOOK_SECRET=ntfset_xxxxxxxx

# Telegram notification for new consultation requests (optional).
# Without both of these set, requests are still saved -- nobody is just told.
# Token from @BotFather; chat id from your own chat with the bot.
# The service agent uses the same bot for handoffs and for the "call these
# people" list while telephony is not connected yet.
TELEGRAM_BOT_TOKEN=123456:xxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# Service agent (talks to customers, books and confirms, reminds about a due
# service and an ending warranty). Full setup: docs/service-agent.md
# ---------------------------------------------------------------------------

# Where customers, cars and bookings live: supabase | crm | odata-1c
SERVICE_AGENT_PROVIDER=supabase
# Row in public.service_shops this deployment serves. Required in crm and
# odata-1c mode, where it is the only thing reminders can be deduplicated by.
# SERVICE_AGENT_SHOP_ID=00000000-0000-0000-0000-000000000000
# Shared secret the telephony platform must send as x-service-agent-secret.
# Without it /api/service-agent/voice and the webhook stay closed.
SERVICE_AGENT_WEBHOOK_SECRET=change_me
# Opus 5.5 by default; a shop that wants shorter pauses on the line can switch
# to claude-sonnet-5-5 or claude-haiku-5-5 here.
# SERVICE_AGENT_MODEL=claude-opus-5-5

# Shop settings. Used as defaults everywhere, and as the whole configuration in
# crm / odata-1c mode, where public.service_shops is not read.
# SERVICE_AGENT_SHOP_NAME=Автосервис на Кабанбай батыра
# SERVICE_AGENT_SHOP_PHONE=+7 717 000 00 00
# SERVICE_AGENT_SHOP_ADDRESS=Астана, Кабанбай батыра 1
# SERVICE_AGENT_TIMEZONE=Asia/Almaty
# SERVICE_AGENT_LOCALE=ru
# Weekday (0 = Sunday) to [open, close]; a missing weekday is a day off.
# SERVICE_AGENT_WORKING_HOURS={"1":["09:00","19:00"],"6":["10:00","16:00"]}
# SERVICE_AGENT_SLOT_MINUTES=60
# SERVICE_AGENT_BAYS=2
# SERVICE_AGENT_INTERVAL_KM=10000
# SERVICE_AGENT_INTERVAL_MONTHS=12
# SERVICE_AGENT_MAINTENANCE_LEAD_DAYS=14
# SERVICE_AGENT_WARRANTY_LEAD_DAYS=30

# Telephony: manual (administrator calls, list comes to Telegram) | vapi
SERVICE_AGENT_TELEPHONY=manual
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_ASSISTANT_ID=

# Authorises the scheduled reminder run (Vercel sends it as a Bearer token).
CRON_SECRET=change_me

# SERVICE_AGENT_PROVIDER=crm
# SERVICE_AGENT_CRM_BASE_URL=https://crm.example.kz/api/v1
# SERVICE_AGENT_CRM_TOKEN=
# SERVICE_AGENT_CRM_AUTH_HEADER=Authorization
# SERVICE_AGENT_CRM_AUTH_SCHEME=Bearer
# SERVICE_AGENT_CRM_PATHS={"customerByPhone":"/customers","vehicles":"/customers/{customerId}/vehicles","visits":"/vehicles/{vehicleId}/visits","appointments":"/appointments","maintenanceDue":"/vehicles/maintenance-due","warrantyExpiring":"/vehicles/warranty-expiring"}

# SERVICE_AGENT_PROVIDER=odata-1c
# SERVICE_AGENT_1C_BASE_URL=https://1c.example.kz/dms/odata/standard.odata
# SERVICE_AGENT_1C_USERNAME=
# SERVICE_AGENT_1C_PASSWORD=
# Entity and property names differ per 1C configuration -- map yours here.
# SERVICE_AGENT_1C_ENTITIES={"customers":"Catalog_Контрагенты","customerPhone":"КонтактнаяИнформация","customerName":"Description","vehicles":"Catalog_Автомобили","vehicleOwner":"Владелец_Key","orders":"Document_ЗаказНаряд"}
